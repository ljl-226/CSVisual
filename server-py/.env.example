# ==========================================================
# CSVisual Python 后端（FastAPI）配置样例
# 用法：复制为 server-py/.env 后按本机情况修改。
# 若不建这个文件，会自动回落到 server/.env（与 Node 后端共用一份配置）。
# 注意：真实 .env 含数据库密码与大模型 Key，已列入 .gitignore，不要提交进源码包。
# ==========================================================

# ---- 服务 ----
PORT=3000
# development | production；production 会强制要求自定义 JWT_SECRET 且 Cookie 带 Secure
CSVISUAL_ENV=development

# ---- MySQL ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=cs_visual

# ---- JWT ----
# 占位值是源码里的公开字符串，任何人都能自签管理员 token，生产环境必须改
JWT_SECRET=csvisual_secret_key_change_me
JWT_EXPIRES=7d

# ---- 跨域白名单 ----
# 逗号分隔，如 https://csvisual.example.com,https://www.example.com
# 留空 = 开发态放通本机常见端口；生产态只允许同源
ALLOWED_ORIGINS=

# ---- 限流（0 = 不限）----
RATE_WINDOW=60
RATE_MAX=600
# 认证类接口（登录/注册/找回密码）防暴力破解
RATE_AUTH_MAX=20
RATE_AUTH_WINDOW=900
# 重资源接口（在线运行代码 / AI 对话）单 IP 每分钟次数
RATE_HEAVY_MAX=30
# 连续登录失败锁定
LOGIN_MAX_FAIL=5
LOGIN_LOCK_MINUTES=15

# ---- Cookie 令牌通道 ----
COOKIE_SECURE=0
COOKIE_NAME=cv_token

# ---- 防重放 ----
# 敏感写接口要求 X-Timestamp（毫秒），与服务端偏差超过该秒数即拒绝
TS_TOLERANCE=300

# ---- 审计日志 ----
AUDIT_LOG=1

# ---- 大模型（OpenAI 兼容接口，如 DeepSeek / 通义千问 / 智谱 / 本地 Ollama）----
# 留空则 Agent 自动降级为「本地知识库检索回答」，无外网也能完整演示。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash
# 思考模式：1 = 先打草稿再作答（延迟明显变长，超时放宽到 120s）
LLM_THINKING=0

# ---- 可选：语义向量检索 ----
# DeepSeek 官方无 /embeddings 接口，这里不要填 DeepSeek 的 Key；
# 留空即使用内置本地 TF-IDF 检索，完全可用。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
